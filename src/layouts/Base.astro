---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  structuredData?: object | object[];
}

const {
  title,
  description = 'Schefer-Fäscht 2027 – vier Festtage vom 20. bis 23. Mai 2027 auf dem Areal der Reto Schefer Gartenbau AG in Uttwil. Livemusik, Streetfood, Schlagerfest, Mustangtreffen und Sportlertalk.',
  structuredData,
} = Astro.props;

const fullTitle = title === 'Home' ? 'Schefer-Fäscht 2027 · 20.–23. Mai · Uttwil' : `${title} | Schefer-Fäscht 2027`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1E4D2B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Schefer-Fäscht 2027" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a href="/" class="brand">Schefer-Fäscht 2027</a>
        <div class="nav-links">
          <a href="/#programm">Programm</a>
          <a href="/#sponsoring">Sponsoring</a>
          <a href="/#kontakt">Kontakt</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>Schefer-Fäscht 2027 · Areal Reto Schefer Gartenbau AG, Uttwil</span>
        <span>Organisation: <a href="https://www.rhc.ch">rhc gmbh</a>, Appenzell · <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></span>
      </div>
      <div class="container footer-copy">© {year} Reto Schefer Gartenbau AG</div>
    </footer>
  </body>
</html>
